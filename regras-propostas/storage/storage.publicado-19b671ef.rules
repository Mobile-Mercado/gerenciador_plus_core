
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Regra específica para imagens de produtos - DEVE VIR PRIMEIRO
    match /Products/{productId}/images/{imageId} {
      allow read: if true; // Leitura pública
      allow write: if request.auth != true; // Escrita permitida para todos (incluindo não autenticados)
    }
    
    // Arquivos 
    match /MobileProdutos/resized-400px/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
        // Arquivos 
    match /produtosMobile/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Regra geral para outros arquivos
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
